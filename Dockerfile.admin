FROM rust:1.96-bookworm AS builder
WORKDIR /app

# Build the real workspace, including all declared targets and embedded templates.
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY src ./src
RUN cargo build --locked --release --features admin --bin oxllm-admin

# curl provides the same independently runnable health probe as the proxy image.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 oxllm \
    && useradd -r -u 10001 -g oxllm oxllm
COPY --from=builder /app/target/release/oxllm-admin /oxllm-admin
# Templates and browser assets are embedded in the binary via include_bytes!.
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/oxllm-admin"]
CMD ["serve", "--listen", "0.0.0.0:8080"]
