# Copy to .env and fill in real values before `docker compose up`.
# Compose supplies dummy provider values for the bundled Docker config so health
# checks need no provider account. Live model calls need valid provider keys.
# The oxllm binary does not load .env; a direct launch needs exported variables.

# Required — proxy master key (Bearer or x-api-key).
OXLLM_MASTER_KEY=

# --- Core provider keys (live LLM smoke) ---
OPENAI_API_KEY=
OPENAI_API_KEY_BACKUP=
XAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
META_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# --- Azure OpenAI ---
AZURE_API_KEY=

# --- AWS Bedrock (direct) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional separate credentials scoped to the Bedrock provider entries.
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=

# --- Mantle (AWS-backed) ---
MANTLE_AWS_ACCESS_KEY_ID=
MANTLE_AWS_SECRET_ACCESS_KEY=

# --- Google Vertex AI ---
GCP_ACCESS_TOKEN=
VERTEX_AI_PROJECT=

# --- Server / ops (Compose) ---
# SQLite is persisted in the oxllm-data named volume. Override for Postgres.
DATABASE_URL=sqlite:///data/oxllm.db?mode=rwc
# Optional; also uncomment general_settings.jwt_secret in the Docker config.
# Use a long random secret. This is separate from DB credential encryption.
JWT_SECRET=
# Optional encryption of provider credentials in DB-managed model records.
# ENCRYPTION_KEY must encode 32 random bytes (64 hex or 44 base64 characters).
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=
# OXLLM_CONFIG_FILE=./examples/config.docker.yaml
# OXLLM_STOP_GRACE_PERIOD=150s

# --- Langfuse observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional admin UI (docker-compose.admin.yml + profile: admin) ---
# Required only when using the admin overlay; session secret: at least 16 chars.
ADMIN_SESSION_SECRET=
ADMIN_UI_PASSWORD=
# Local HTTP on 127.0.0.1 only. Set true when serving the admin UI over HTTPS.
ADMIN_COOKIE_SECURE=false

RUST_LOG=info,oxllm=info,oxllm_server=info
